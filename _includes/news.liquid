{% comment %}
  Local override of al_folio_core 1.0.15 _includes/news.liquid.
  Show month precision and render each shared news item in the page language.
{% endcomment %}
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{% if page.lang == 'zh-CN' %}{{ item.date | date: '%Y 年 %-m 月' }}{% else %}{{ item.date | date: '%b %Y' }}{% endif %}</th>
            <td>
              {% if page.lang == 'zh-CN' and item.content_zh %}
                {{ item.content_zh | markdownify | remove: '<p>' | remove: '</p>' }}
              {% elsif item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
              {% if item.photos and include.limit != true %}
                {% assign photo_label = item.photo_label %}
                {% if page.lang == 'zh-CN' %}{% assign photo_label = item.photo_label_zh %}{% endif %}
                <div class="conference-photos">
                  {% for photo in item.photos %}
                    <a href="{{ photo | relative_url }}"><img src="{{ photo | relative_url }}" loading="lazy" alt="{{ photo_label | escape }} · {{ forloop.index }}"></a>
                  {% endfor %}
                </div>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{% if page.lang == 'zh-CN' %}暂无动态。{% else %}No news so far...{% endif %}</p>
  {% endif %}
</div>
