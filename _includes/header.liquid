{% include page-languages.liquid %}
{% assign home_url = '/' %}
{% assign home_label = 'about' %}
{% assign site_name = 'Weiyi Wang' %}
{% assign alternate_url = '/zh/' %}
{% assign alternate_label = '中文' %}
{% assign alternate_language = 'zh-CN' %}
{% assign alternate_title = '切换到中文版' %}
{% assign theme_label = 'Change color theme' %}
{% assign search_label = 'Open search' %}
{% if chinese_page %}{% assign alternate_url = chinese_url %}{% endif %}
{% if is_chinese %}
  {% assign home_url = '/zh/' %}
  {% assign home_label = '首页' %}
  {% assign site_name = '王唯逸' %}
  {% assign alternate_url = english_url %}
  {% assign alternate_label = 'English' %}
  {% assign alternate_language = 'en' %}
  {% assign alternate_title = 'Switch to English' %}
  {% assign theme_label = '切换配色主题' %}
  {% assign search_label = '打开搜索' %}
{% endif %}
<header>
  <nav id="navbar" class="navbar navbar-light {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="{% if is_chinese %}主导航{% else %}Main navigation{% endif %}">
    <div class="container">
      {% if page.url != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">{{ site_name }}</a>
      {% endif %}
      <a class="language-switch" href="{{ alternate_url | relative_url }}" lang="{{ alternate_language }}" hreflang="{{ alternate_language }}" aria-label="{{ alternate_title }}">{{ alternate_label }}</a>
      <div class="navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list">
          <li class="nav-item {% if page.url == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}"{% if page.url == home_url %} aria-current="page"{% endif %}>{{ home_label }}</a>
          </li>
          {% assign navigation_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
          {% for nav_page in navigation_pages %}
            {% assign nav_label = nav_page.title %}
            {% assign nav_url = nav_page.url %}
            {% if is_chinese and nav_page.nav_zh %}
              {% assign nav_label = nav_page.nav_zh %}
              {% assign nav_url = nav_url | prepend: '/zh' %}
            {% endif %}
            <li class="nav-item {% if page.url contains nav_url %}active{% endif %}">
              <a class="nav-link" href="{{ nav_url | relative_url }}"{% if page.url == nav_url %} aria-current="page"{% endif %}>{{ nav_label }}</a>
            </li>
          {% endfor %}
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" type="button" title="{{ search_label }}" aria-label="{{ search_label }}">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="{{ theme_label }}" aria-label="{{ theme_label }}">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0" aria-hidden="true">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
